local fetchMyProfile
fetchMyProfile = function(callback)
    checkIfBlocked(function(blocked)
        if blocked then
            tts("You are blocked by admin.")
            callback("blocked", nil)
            return
        end
        executeHttp("GET", base_url_profiles .. android_id .. ".json", nil, function(c, r)
            if c == "200" and r ~= "null" and r ~= "" then
                local j = JSONObject(r)
                local isPending = j.has("pendingDelete") and j.getBoolean("pendingDelete")
                if isPending then
                    local pts = j.has("pendingDeleteTimestamp") and j.getInt("pendingDeleteTimestamp") or 0
                    local now = os.time()
                    if now - pts >= DELETE_WAIT_SECONDS then
                        executeHttp("DELETE", base_url_profiles .. android_id .. ".json", nil, function()
                            callback("not_found", nil)
                        end)
                    else
                        callback("pending_delete", j)
                    end
                else
                    currentUsername = j.getString("name")
                    currentProfileData = j
                    callback("active", j)
                end
            else
                callback("not_found", nil)
            end
        end)
    end)
end

