-- Public Chat Messages Loader with Admin Tag + 24hr Auto Expiry
local function loadMessages()
    if not isChatActive then return end
    executeHttp("GET", db_url_chat, nil, function(code, res)
        if not isChatActive then return end
        if code == "200" and res ~= "null" and res ~= "" then
            pcall(function()
                local json = JSONObject(res)
                local keys = {}
                local iter = json.keys()
                while iter.hasNext() do table.insert(keys, iter.next()) end
                table.sort(keys)
                
                local newValues = {}
                local tempKeys = {}
                local hasNewIncomingMsg = false
                local justScroll = false
                local latestSpeak = ""
                local amIMentioned = false
                local validMsgCount = 0 
                local now = os.time()
                
                for i, k in ipairs(keys) do
                    local obj = json.getJSONObject(k)
                    local ts = obj.has("timestamp") and obj.getInt("timestamp") or 0
                    
                    if ts > 0 and (now - ts) > EXPIRY_SECONDS then
                        executeHttp("DELETE", base_url_chat .. k .. ".json", nil, function() end)
                    elseif lastClearedKey == "" or k > lastClearedKey then
                        validMsgCount = validMsgCount + 1
                        local senderID = obj.has("sender_id") and obj.getString("sender_id") or ""
                        local senderName = obj.getString("sender")
                        local text = obj.getString("text")
                        local rep = obj.has("replyTo") and obj.getString("replyTo") or ""
                        local tme = obj.has("time") and obj.getString("time") or ""
                        local audB64 = obj.has("audioBase64") and obj.getString("audioBase64") or ""
                        
                        rawMessages[k] = {sender_id=senderID, senderName=senderName, text=text, replyTo=rep, time=tme, audioBase64=audB64}
                        
                        local dispName = senderName
                        if isAdminName(senderName) then 
                            dispName = "[Admin 🧑‍💻] " .. senderName 
                        end
                        
                        local displayStr = dispName .. ": "
                        if rep ~= "" then displayStr = displayStr .. "[Replying to " .. rep .. "] " end
                        if audB64 ~= "" then displayStr = displayStr .. "🎙️ [Voice Message]" else displayStr = displayStr .. text end
                        displayStr = displayStr .. " (" .. tme .. ")"
                        
                        if senderID == android_id then
                            displayStr = displayStr .. " [Sent]"
                        else
                            displayStr = displayStr .. " [Received]"
                        end
                        
                        table.insert(newValues, displayStr)
                        table.insert(tempKeys, k)
                        
                        if not knownKeys[k] then
                            knownKeys[k] = true
                            if senderID == android_id then
                                justScroll = true
                            else
                                hasNewIncomingMsg = true
                                if audB64 ~= "" then 
                                    latestSpeak = dispName .. " ka voice message aaya hai." 
                                else 
                                    latestSpeak = dispName .. " ka message: " .. text 
                                end
                                if text:find("@" .. currentUsername) then 
                                    amIMentioned = true 
                                    latestSpeak = dispName .. " ne aapko mention kiya hai."
                                end
                            end
                        end
                    else 
                        knownKeys[k] = true 
                    end
                end
                
                itemKeys = tempKeys
