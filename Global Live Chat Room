-- ================= PRIVATE CHAT SYSTEM =================
local privateItemKeys = {}
local privateItemValues = {}
local privateRawMessages = {}
local isPrivateActive = false

local function loadPrivateMessages()
    if not isPrivateActive then return end
    local chatRoomKey = getPrivateChatKey(android_id, currentChatPartnerID)
    local private_url = base_url_private .. chatRoomKey .. ".json"
    
    executeHttp("GET", private_url, nil, function(code, res)
        if not isPrivateActive then return end
        local newValues = {}
        local tempKeys = {}
        
        if code == "200" and res ~= "null" and res ~= "" then
            pcall(function()
                local json = JSONObject(res)
                local keys = {}
                local iter = json.keys()
                while iter.hasNext() do table.insert(keys, iter.next()) end
                table.sort(keys)
                
                local now = os.time()
                for i, k in ipairs(keys) do
                    local obj = json.getJSONObject(k)
                    local ts = obj.has("timestamp") and obj.getInt("timestamp") or 0
                    
                    if ts > 0 and (now - ts) > EXPIRY_SECONDS then
                        executeHttp("DELETE", base_url_private .. chatRoomKey .. "/" .. k .. ".json", nil, function() end)
                    elseif currentPrivateClearedKey == "" or k > currentPrivateClearedKey then
                        local sID = obj.getString("sender_id")
                        local sName = obj.getString("sender")
                        local text = obj.getString("text")
                        local tme = obj.getString("time")
                        
                        privateRawMessages[k] = {sender_id=sID, sender=sName, text=text, time=tme}
                        
                        local dispName = sName
                        if isAdminName(sName) then dispName = "[Admin 🧑‍💻] " .. sName end
                        
                        local disp = dispName .. ": " .. text .. " (" .. tme .. ")"
                        if sID == android_id then disp = disp .. " [Sent]" else disp = disp .. " [Received]" end
                        
                        table.insert(newValues, disp)
                        table.insert(tempKeys, k)
                    end
                end
            end)
        end
        
        privateItemKeys = tempKeys
        privateItemValues = newValues
        ui.privateChatList.setAdapter(ArrayAdapter(service, android.R.layout.simple_list_item_1, String(privateItemValues)))
        if #privateItemValues > 0 then
            ui.privateChatList.setSelection(#privateItemValues - 1)
        end
        
        if isPrivateFirstLoad then
            if #privateItemValues == 0 then
                tts("Koi message nahi hai.")
            else
                tts(#privateItemValues .. " messages available hain.")
            end
            isPrivateFirstLoad = false
        end
    end)
end

local function startPrivateAutoRefresh()
    if not isPrivateActive then return end
    loadPrivateMessages()
    ui_handler.postDelayed(Runnable{run=startPrivateAutoRefresh}, 5000)
end

