ui.btnOnline.onClick = function()
    ui.moreMenuView.setVisibility(View.GONE) 
    ui.onlineView.setVisibility(View.VISIBLE) 
    ui.tvOnlineHeader.setText("Loading...")
    tts("Online users list open ho gayi.")
    
    executeHttp("GET", db_url_online, nil, function(code, res)
        if code == "200" and res ~= "null" and res ~= "" then
            pcall(function()
                local j = JSONObject(res) 
                currentOnlineUsersList = {} 
                local it = j.keys() 
                local current_time = os.time()
                while it.hasNext() do 
                    local rawKey = it.next() 
                    local userObj = j.getJSONObject(rawKey) 
                    local lastActive = userObj.has("lastActive") and userObj.getInt("lastActive") or 0
                    if current_time - lastActive <= 30 then 
                        table.insert(currentOnlineUsersList, rawKey)
                    end
                end
                
                local loadedNames = {}
                local countLoaded = 0
                if #currentOnlineUsersList == 0 then
                    ui.tvOnlineHeader.setText("Total Online Users: 0")
                    ui.onlineList.setAdapter(ArrayAdapter(service, android.R.layout.simple_list_item_1, String({})))
                else
                    for _, u_id in ipairs(currentOnlineUsersList) do
                        executeHttp("GET", base_url_profiles .. u_id .. "/name.json", nil, function(c2, r2)
                            countLoaded = countLoaded + 1
                            if c2 == "200" and r2 ~= "null" and r2 ~= "" then
                                local cleanName = (r2:gsub('"', ''))
                                table.insert(loadedNames, cleanName)
                            end
                            if countLoaded == #currentOnlineUsersList then
                                ui.tvOnlineHeader.setText("Total Online Users: " .. #loadedNames) 
                                ui.onlineList.setAdapter(ArrayAdapter(service, android.R.layout.simple_list_item_1, String(loadedNames)))
                            end
                        end)
                    end
                end
            end)
        else 
            ui.tvOnlineHeader.setText("Total Online Users: 0") 
            ui.onlineList.setAdapter(ArrayAdapter(service, android.R.layout.simple_list_item_1, String({}))) 
        end
    end)
end

