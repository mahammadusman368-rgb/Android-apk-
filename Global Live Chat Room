-- ================= AUDIO RECORDING =================
local function stopRecordingInternal()
    pcall(function()
        mediaRecorder.stop() 
        mediaRecorder.release() 
        mediaRecorder = nil 
    end)
    isRecording = false
    ui.btnMic.setText("Mic") 
    ui.normalChatBar.setVisibility(View.GONE) 
    ui.audioPreviewBar.setVisibility(View.VISIBLE)
    tts("Recording khatam ho gayi. Ab sun rahe hain.")
    
    stopAnyPlayingAudio()
    pcall(function()
        chatPlayer = luajava.newInstance("android.media.MediaPlayer") 
        chatPlayer.setDataSource(audio_record_file) 
        chatPlayer.prepare() 
        chatPlayer.start() 
    end)
end

ui.btnMic.onClick = function()
    checkVoiceLimitFirebase(function(currentCount)
        if currentCount >= 10 then
            tts("Daily voice limit reached. Try again tomorrow.")
            return
        end

        if not isRecording then
            local ok, err = pcall(function()
                if mediaRecorder then mediaRecorder.release() end
                mediaRecorder = luajava.newInstance("android.media.MediaRecorder")
                mediaRecorder.setAudioSource(1) 
                mediaRecorder.setOutputFormat(2) 
                mediaRecorder.setAudioEncoder(3)
                mediaRecorder.setAudioEncodingBitRate(128000) 
                mediaRecorder.setAudioSamplingRate(44100) 
                mediaRecorder.setMaxDuration(20000)
                mediaRecorder.setOutputFile(audio_record_file)
                mediaRecorder.prepare()
                mediaRecorder.start()
                isRecording = true
                ui.btnMic.setText("Stop")
                tts("Voice recording start hui. Max 20 second.")
                
                recordLimitRunnable = Runnable{run=function()
                    if isRecording then stopRecordingInternal() end
                end}
                ui_handler.postDelayed(recordLimitRunnable, 20000)
            end)
        else
            if recordLimitRunnable then
                ui_handler.removeCallbacks(recordLimitRunnable)
                recordLimitRunnable = nil
            end
            stopRecordingInternal()
        end
    end)
end

