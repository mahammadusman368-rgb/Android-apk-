local function showPendingDeletions()
    executeHttp("GET", db_url_profiles, nil, function(c, r)
        if c ~= "200" or r == "null" or r == "" then
            tts("Koi pending deletion nahi hai.")
            return
        end
        local uids = {}
        local labels = {}
        pcall(function()
            local j = JSONObject(r)
            local it = j.keys()
            local now = os.time()
            while it.hasNext() do
                local uid = it.next()
                local obj = j.getJSONObject(uid)
                if obj.has("pendingDelete") and obj.getBoolean("pendingDelete") then
                    local pts = obj.has("pendingDeleteTimestamp") and obj.getInt("pendingDeleteTimestamp") or 0
                    local daysLeft = 7 - math.floor((now - pts) / 86400)
                    if daysLeft < 0 then daysLeft = 0 end
                    local nm = obj.has("name") and obj.getString("name") or uid
                    table.insert(uids, uid)
                    table.insert(labels, nm .. " - " .. daysLeft .. " din baaki")
                end
            end
        end)
        if #uids == 0 then
            tts("Koi pending deletion nahi hai.")
            return
        end
        local pd = AlertDialog.Builder(service)
        pd.setTitle("Pending Deletions")
        pd.setItems(String(labels), {onClick=function(di, w)
            local targetUid = uids[w + 1]
            local sd = AlertDialog.Builder(service)
            sd.setTitle("Choose Action")
            sd.setItems(String({"Restore", "Delete Now", "Go Back"}), {onClick=function(di2, w2)
                if w2 == 0 then
                    executeHttp("GET", base_url_profiles .. targetUid .. ".json", nil, function(c3, r3)
                        if c3 == "200" and r3 ~= "null" then
                            pcall(function()
                                local oj = JSONObject(r3)
                                local restored = JSONObject()
                                restored.put("name", oj.getString("name"))
                                restored.put("location", oj.getString("location"))
                                restored.put("bio", oj.getString("bio"))
                                restored.put("lastUpdated", oj.has("lastUpdated") and oj.getInt("lastUpdated") or os.time())
                                executeHttp("PUT", base_url_profiles .. targetUid .. ".json", restored.toString(), function()
                                    tts("Profile restore ho gayi.")
                                end)
                            end)
                        end
                    end)
                elseif w2 == 1 then
                    executeHttp("DELETE", base_url_profiles .. targetUid .. ".json", nil, function()
                        tts("Profile permanently delete ho gayi.")
                    end)
                end
            end})
            local sa = sd.create()
            sa.getWindow().setType(WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY)
            sa.show()
        end})
        local pa = pd.create()
        pa.getWindow().setType(WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY)
        pa.show()
    end)
end

