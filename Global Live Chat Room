ui.btnSendAudio.onClick = function()
    stopAnyPlayingAudio() 
    ui.btnSendAudio.setText("Sending...") 
    ui.btnSendAudio.setEnabled(false) 
    ui.btnCancelAudio.setEnabled(false) 
    ui.btnPlayPreview.setEnabled(false)
    
    local b64Audio = encodeFileToBase64(audio_record_file)
    if b64Audio ~= "" then
        checkVoiceLimitFirebase(function(currentCount)
            if currentCount >= 10 then
                ui.btnSendAudio.setText("Send") 
                ui.btnSendAudio.setEnabled(true) 
                ui.btnCancelAudio.setEnabled(true) 
                ui.btnPlayPreview.setEnabled(true)
                tts("Daily voice limit reached.")
                return
            end
            
            local finalSenderName = currentUsername
            if isAdminName(currentUsername) then finalSenderName = adminName end

            local msgObj = JSONObject()
            msgObj.put("sender_id", android_id)
            msgObj.put("sender", finalSenderName)
            msgObj.put("text", "[Voice Message]")
            msgObj.put("audioBase64", b64Audio)
            msgObj.put("replyTo", replyingTo)
            msgObj.put("time", os.date("%I:%M %p"))
            msgObj.put("timestamp", os.time())
            
            executeHttp("POST", db_url_chat, msgObj.toString(), function(c, r)
                ui.btnSendAudio.setText("Send") 
                ui.btnSendAudio.setEnabled(true) 
                ui.btnCancelAudio.setEnabled(true) 
                ui.btnPlayPreview.setEnabled(true)
                
                if c == "200" then 
                    incrementVoiceLimitFirebase(currentCount, function()
                        tts("Voice message sent.") 
                        ui.audioPreviewBar.setVisibility(View.GONE) 
                        ui.normalChatBar.setVisibility(View.VISIBLE) 
                        File(audio_record_file).delete() 
                        if replyingTo ~= "" then 
                            replyingTo = "" 
                            ui.replyText.setVisibility(View.GONE) 
                        end 
                        loadMessages()
                    end)
                else 
                    tts("Network error. Failed to send.") 
                end
            end)
        end)
    else
        ui.btnSendAudio.setText("Send") 
        ui.btnSendAudio.setEnabled(true) 
        ui.btnCancelAudio.setEnabled(true) 
        ui.btnPlayPreview.setEnabled(true)
    end
end

