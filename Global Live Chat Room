                local it = j.keys()
                while it.hasNext() do
                    local uid = it.next()
                    if uid ~= android_id then
                        local obj = j.getJSONObject(uid)
                        local pending = obj.has("pendingDelete") and obj.getBoolean("pendingDelete")
                        if not pending and obj.has("name") and obj.getString("name") == name then
